# Copy to .env.local and replace the development role password.
# The Java app reads process environment variables; source .env.local before launch.
HOSPITAL_DB_HOST=localhost
HOSPITAL_DB_PORT=5432
HOSPITAL_DB_NAME=hospital_management_dev
HOSPITAL_DB_USER=hms_app_dev
HOSPITAL_DB_PASSWORD=replace-with-local-development-password
HOSPITAL_DB_SSLMODE=disable

# Optional one-time first-admin provisioning. Unset these after first startup.
# HOSPITAL_INITIAL_ADMIN_USERNAME=
# HOSPITAL_INITIAL_ADMIN_EMAIL=
# HOSPITAL_INITIAL_ADMIN_PASSWORD=
